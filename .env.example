# PostgreSQL connection (optional for inventory phase; required for DB load)
WWE_DATABASE_URL=postgresql+psycopg2://wwe:wwe@localhost:5432/wwe_history

# Collection bounds
WWE_START_YEAR=2000
WWE_END_YEAR=2027

# HTTP
WWE_USER_AGENT=WWE-Historical-Data-Platform/0.1 (+research; respectful; contact=local)
WWE_REQUEST_DELAY_SECONDS=1.0

# Paths
WWE_DATA_DIR=data
WWE_CONFIG_DIR=config
